{
  "name": "waveforge-stellar",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "Stellar Wave readiness checker and issue linter",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "waveforge": "./dist/cli.js"
  },
  "waveforge": {
    "actionRef": "Soroban-Clear-Sign-Kit/waveforge-action@v1"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "tsup",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "17.2.1",
    "smol-toml": "1.9.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.4",
    "eslint": "10.12.0",
    "tsup": "9.0.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  }
}
